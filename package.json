{
  "name": "doinik-life-react",
  "productName": "Doinik Life",
  "description": "Tasks, expenses, notes and habits — your daily dashboard.",
  "author": "Doinik Life",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "desktop": "vite build && electron .",
    "app:win": "vite build && electron-builder --win",
    "app:mac": "vite build && electron-builder --mac",
    "app:android": "vite build && npx cap sync android"
  },
  "build": {
    "appId": "com.doiniklife.app",
    "productName": "Doinik Life",
    "copyright": "Doinik Life",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "public/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Doinik Life",
      "artifactName": "Doinik-Life-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Doinik-Life-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "public/icon-512.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Doinik-Life-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "firebase": "^12.0.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1"
  }
}
