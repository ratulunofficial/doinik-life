{
  "name": "doinik-life-desktop",
  "version": "1.0.0",
  "description": "Doinik Life — native macOS desktop wrapper",
  "main": "main.js",
  "private": true,
  "author": {
    "name": "Doinik Life",
    "email": "hello@doinik.life"
  },
  "homepage": "https://doinik.life",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac dmg",
    "dist:universal": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^31.7.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "life.doinik.desktop",
    "productName": "Doinik Life",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "title": "Doinik Life ${version}",
      "icon": "build/icon.png",
      "iconSize": 110,
      "window": {
        "width": 540,
        "height": 360
      },
      "contents": [
        { "x": 140, "y": 170, "type": "file" },
        { "x": 400, "y": 170, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
